generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───

enum Role {
  ADMIN
  SUBCONTRACTOR
}

enum SubcontractorStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum LeadType {
  CUSTOMER
  SUBCONTRACTOR
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum JobStatus {
  DRAFT
  OFFERED
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  PAID
  CANCELLED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
}

// ─── NextAuth Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ───

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(SUBCONTRACTOR)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subcontractor Subcontractor?
  smsBlasts     SmsBlast[]
}

model Subcontractor {
  id              String              @id @default(cuid())
  userId          String?             @unique
  companyName     String
  contactName     String
  phone           String
  email           String
  status          SubcontractorStatus @default(PENDING)
  crewSize        Int?
  yearsInTrade    Int?
  licenseInfo     String?             @db.Text
  insuranceStatus String?             @db.Text
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User?               @relation(fields: [userId], references: [id])
  trades          Service[]           @relation("SubcontractorTrades")
  serviceAreas    City[]              @relation("SubcontractorServiceAreas")
  jobAssignments  JobAssignment[]
  jobPhotos       JobPhoto[]
  smsRecipients   SmsRecipient[]
}

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
}

model Service {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  categoryId String
  licensed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  subcontractors Subcontractor[] @relation("SubcontractorTrades")
  leads          Lead[]
  jobs           Job[]
}

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  county    String
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcontractors Subcontractor[] @relation("SubcontractorServiceAreas")
  leads          Lead[]
  jobs           Job[]
}

model Lead {
  id           String    @id @default(cuid())
  type         LeadType
  name         String
  email        String?
  phone        String?
  serviceId    String?
  cityId       String?
  propertyType String?
  scope        String?   @db.Text
  source       String    @default("website-customer-form")
  stage        LeadStage @default(NEW)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  service Service? @relation(fields: [serviceId], references: [id])
  city    City?    @relation(fields: [cityId], references: [id])
  jobs    Job[]
}

model Job {
  id            String    @id @default(cuid())
  title         String
  serviceId     String
  cityId        String
  customerName  String
  customerPhone String?
  customerEmail String?
  scope         String?   @db.Text
  status        JobStatus @default(DRAFT)
  scheduledDate DateTime?
  amount        Decimal?  @db.Decimal(12, 2)
  leadId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  service     Service         @relation(fields: [serviceId], references: [id])
  city        City            @relation(fields: [cityId], references: [id])
  lead        Lead?           @relation(fields: [leadId], references: [id])
  assignments JobAssignment[]
  photos      JobPhoto[]
  smsBlasts   SmsBlast[]
}

model JobAssignment {
  id              String           @id @default(cuid())
  jobId           String
  subcontractorId String
  status          AssignmentStatus @default(OFFERED)
  respondedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  job           Job           @relation(fields: [jobId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])

  @@unique([jobId, subcontractorId])
}

model JobPhoto {
  id                        String   @id @default(cuid())
  jobId                     String
  url                       String
  caption                   String?
  uploadedBySubcontractorId String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  job           Job           @relation(fields: [jobId], references: [id])
  subcontractor Subcontractor @relation(fields: [uploadedBySubcontractorId], references: [id])
}

model SmsBlast {
  id           String   @id @default(cuid())
  message      String   @db.Text
  jobId        String?
  sentByUserId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job        Job?           @relation(fields: [jobId], references: [id])
  sentBy     User           @relation(fields: [sentByUserId], references: [id])
  recipients SmsRecipient[]
}

model SmsRecipient {
  id              String   @id @default(cuid())
  blastId         String
  subcontractorId String
  phone           String
  twilioSid       String?
  status          String   @default("queued")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blast         SmsBlast      @relation(fields: [blastId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
}
