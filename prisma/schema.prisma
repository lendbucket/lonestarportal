generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───

enum Role {
  ADMIN
  SUBCONTRACTOR
}

enum SubcontractorStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum LeadType {
  CUSTOMER
  SUBCONTRACTOR
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum JobStatus {
  DRAFT
  OFFERED
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  PAID
  CANCELLED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
}

// ─── NextAuth Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ───

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(SUBCONTRACTOR)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subcontractor Subcontractor?
  smsBlasts     SmsBlast[]
  approvedDrafts BidDraft[]
}

model Subcontractor {
  id              String              @id @default(cuid())
  userId          String?             @unique
  companyName     String
  contactName     String
  phone           String
  email           String
  status          SubcontractorStatus @default(PENDING)
  smsOptOut       Boolean             @default(false)
  crewSize        Int?
  yearsInTrade    Int?
  licenseInfo     String?             @db.Text
  insuranceStatus String?             @db.Text
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User?               @relation(fields: [userId], references: [id])
  trades          Service[]           @relation("SubcontractorTrades")
  serviceAreas    City[]              @relation("SubcontractorServiceAreas")
  jobAssignments  JobAssignment[]
  jobPhotos       JobPhoto[]
  smsRecipients   SmsRecipient[]
}

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
}

model Service {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  categoryId String
  licensed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  subcontractors Subcontractor[] @relation("SubcontractorTrades")
  leads          Lead[]
  jobs           Job[]
}

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  county    String
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcontractors Subcontractor[] @relation("SubcontractorServiceAreas")
  leads          Lead[]
  jobs           Job[]
}

model Lead {
  id           String    @id @default(cuid())
  type         LeadType
  name         String
  email        String?
  phone        String?
  serviceId    String?
  cityId       String?
  propertyType String?
  scope        String?   @db.Text
  source       String    @default("website-customer-form")
  stage        LeadStage @default(NEW)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  service Service? @relation(fields: [serviceId], references: [id])
  city    City?    @relation(fields: [cityId], references: [id])
  jobs    Job[]
}

model Job {
  id            String    @id @default(cuid())
  title         String
  serviceId     String
  cityId        String
  customerName  String
  customerPhone String?
  customerEmail String?
  scope         String?   @db.Text
  status        JobStatus @default(DRAFT)
  scheduledDate DateTime?
  amount        Decimal?  @db.Decimal(12, 2)
  leadId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  service       Service         @relation(fields: [serviceId], references: [id])
  city          City            @relation(fields: [cityId], references: [id])
  lead          Lead?           @relation(fields: [leadId], references: [id])
  assignments   JobAssignment[]
  photos        JobPhoto[]
  smsBlasts     SmsBlast[]
  solicitations Solicitation[]
}

model JobAssignment {
  id              String           @id @default(cuid())
  jobId           String
  subcontractorId String
  status          AssignmentStatus @default(OFFERED)
  respondedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  job           Job           @relation(fields: [jobId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])

  @@unique([jobId, subcontractorId])
}

model JobPhoto {
  id                        String   @id @default(cuid())
  jobId                     String
  url                       String
  caption                   String?
  uploadedBySubcontractorId String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  job           Job           @relation(fields: [jobId], references: [id])
  subcontractor Subcontractor @relation(fields: [uploadedBySubcontractorId], references: [id])
}

model SmsBlast {
  id           String   @id @default(cuid())
  message      String   @db.Text
  jobId        String?
  sentByUserId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job        Job?           @relation(fields: [jobId], references: [id])
  sentBy     User           @relation(fields: [sentByUserId], references: [id])
  recipients SmsRecipient[]
}

model SmsRecipient {
  id              String   @id @default(cuid())
  blastId         String
  subcontractorId String
  phone           String
  twilioSid       String?
  status          String   @default("queued")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blast         SmsBlast      @relation(fields: [blastId], references: [id])
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
}

// ─── Bid Engine Models ───

model CompanyBidProfile {
  id                  String   @id @default(cuid())
  legalName           String
  dba                 String?
  addressStreet       String?
  addressCity         String?
  addressState        String?
  addressZip          String?
  phone               String?
  email               String?
  websiteUrl          String?
  uei                 String?
  cage                String?
  duns                String?
  naicsCodes          String[] @default([])
  bondingCapacity     String?
  standardMarkupNotes String?  @db.Text
  capabilityStatement String?  @db.Text
  w9OnFile            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  licenses          BidLicense[]
  insurancePolicies InsurancePolicy[]
  certifications    Certification[]
  references        BidReference[]
  documents         BidDocument[]
}

model BidLicense {
  id        String    @id @default(cuid())
  profileId String
  type      String
  number    String
  state     String
  expiresOn DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  profile CompanyBidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model InsurancePolicy {
  id           String    @id @default(cuid())
  profileId    String
  type         String
  carrier      String
  policyNumber String
  limit        String?
  expiresOn    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile CompanyBidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certification {
  id        String    @id @default(cuid())
  profileId String
  name      String
  number    String?
  issuer    String?
  expiresOn DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  profile CompanyBidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model BidReference {
  id           String   @id @default(cuid())
  profileId    String
  projectName  String
  clientName   String
  contactName  String?
  contactPhone String?
  contactEmail String?
  value        Decimal? @db.Decimal(12, 2)
  year         Int?
  scopeSummary String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile CompanyBidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model BidDocument {
  id        String   @id @default(cuid())
  profileId String
  label     String
  fileUrl   String
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CompanyBidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum SolicitationSource {
  GMAIL
  BIDNET
  MANUAL
}

enum SolicitationStatus {
  NEW
  DRAFTING
  DRAFT_READY
  NEEDS_DOC
  APPROVED
  SUBMITTED
  WON
  LOST
  SKIPPED
}

model GmailConnection {
  id                    String    @id @default(cuid())
  emailAddress          String
  encryptedRefreshToken String    @db.Text
  encryptedAccessToken  String?   @db.Text
  accessTokenExpiresAt  DateTime?
  lastHistoryId         String?
  lastSyncedAt          DateTime?
  status                String    @default("connected")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Solicitation {
  id                  String             @id @default(cuid())
  source              SolicitationSource
  gmailMessageId      String?            @unique
  sourceLink          String?
  receivedAt          DateTime
  issuingEntity       String
  solicitationNumber  String?
  title               String
  scope               String?            @db.Text
  tradeCategory       String?
  location            String?
  dueDate             DateTime?
  submissionMethod    String?            @db.Text
  submissionContact   String?            @db.Text
  requirements        Json?
  rawEmailExcerpt     String?            @db.Text
  needsSourceDocument Boolean            @default(false)
  status              SolicitationStatus @default(NEW)
  jobId               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  job         Job?                      @relation(fields: [jobId], references: [id])
  attachments SolicitationAttachment[]
  draft       BidDraft?
}

model SolicitationAttachment {
  id             String   @id @default(cuid())
  solicitationId String
  label          String
  fileUrl        String
  mimeType       String?
  extractedText  String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  solicitation Solicitation @relation(fields: [solicitationId], references: [id], onDelete: Cascade)
}

model BidDraft {
  id               String    @id @default(cuid())
  solicitationId   String    @unique
  generatedContent String    @db.Text
  editedContent    String?   @db.Text
  enclosures       Json?
  aiModel          String
  generatedAt      DateTime  @default(now())
  approvedAt       DateTime?
  approvedByUserId String?
  submittedAt      DateTime?
  submissionNotes  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  solicitation Solicitation @relation(fields: [solicitationId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation(fields: [approvedByUserId], references: [id])
}

model ProcessedGmailMessage {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  classification String
  createdAt      DateTime @default(now())
}

// ─── Rate Limiting ───

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
