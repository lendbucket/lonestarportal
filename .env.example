# Database (Supabase Postgres)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Resend
RESEND_API_KEY=re_your-api-key
LEAD_FROM_EMAIL=portal@lonestarcontractinggroup.com

# Lead Intake
LEAD_INTAKE_SECRET=your-shared-secret

# Admin Seed
ADMIN_EMAIL=admin@lonestarcontractinggroup.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Robert

# Gmail API (Bid Engine)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=https://portal.lonestarcontractinggroup.com/api/integrations/gmail/callback

# Anthropic (Bid Engine AI)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Bid Engine Security
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key
CRON_SECRET=your-cron-secret
